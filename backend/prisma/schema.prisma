generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id          Int          @id @default(autoincrement())
  nome        String
  email       String       @unique
  senha       String
  jogos       Jogo[]
  comentarios Comentario[]
}

model Usuario {
  id          Int          @id @default(autoincrement())
  nome        String
  email       String       @unique
  senha       String
  avaliacoes  Avaliacao[]
  comentarios Comentario[]
}

model Jogo {
  id          Int          @id @default(autoincrement())
  titulo      String
  descricao   String
  lore        String?
  destaque    Boolean      @default(false)
  ano         Int
  capaUrl     String
  adminId     Int
  avaliacoes  Avaliacao[]
  comentarios Comentario[]
  admin       Admin        @relation(fields: [adminId], references: [id])
}

model Avaliacao {
  id         Int     @id @default(autoincrement())
  nota       Int
  comentario String
  usuarioId  Int
  jogoId     Int
  jogo       Jogo    @relation(fields: [jogoId], references: [id])
  usuario    Usuario @relation(fields: [usuarioId], references: [id])
}

model Comentario {
  id        Int          @id @default(autoincrement())
  texto     String
  criadoEm  DateTime     @default(now())
  jogoId    Int
  usuarioId Int?
  adminId   Int?
  parentId  Int?
  jogo      Jogo         @relation(fields: [jogoId], references: [id], onDelete: Cascade)
  usuario   Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  admin     Admin?       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  parent    Comentario?  @relation("ComentarioReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comentario[] @relation("ComentarioReplies")

  @@index([jogoId])
  @@index([parentId])
}
